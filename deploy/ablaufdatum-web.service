[Unit]
Description=Ablaufdatum-Tracker Web Server
After=network.target

[Service]
Type=simple
User=ablaufdatum
Group=ablaufdatum
ExecStart=/usr/local/bin/ablaufdatum-tracker
EnvironmentFile=/etc/ablaufdatum/env
Environment=ABLAUFDATUM_CSV=/var/lib/ablaufdatum/artikel.csv
StateDirectory=ablaufdatum
Restart=on-failure
RestartSec=5

# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
